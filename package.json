{
  "name": "quiz-app-v2",
  "private": true,
  "version": "0.1.0",
  "description": "PLUS ULTRA Quiz rebuild — Prisma + Express + React, SQLite local / MySQL prod",
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "db:push": "pnpm --filter api db:push",
    "db:seed": "pnpm --filter api db:seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild", "fsevents"]
  }
}
