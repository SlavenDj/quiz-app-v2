# Local dev = SQLite (schema.prisma). Prod/cPanel = MySQL (schema.mysql.prisma).
# Switch by generating the right client + DATABASE_URL. See README.
DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET=change-me-32chars-min
JWT_REFRESH_SECRET=change-me-32chars-min
API_PUBLIC_URL=http://localhost:3000
WEB_URL=http://localhost:5173
RESEND_API_KEY=
PORT=3000
