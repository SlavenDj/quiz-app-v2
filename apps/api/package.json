{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:push": "prisma db push",
    "db:sync-schemas": "sed 's/^  provider = \"sqlite\"$/  provider = \"mysql\"/' prisma/schema.prisma > prisma/schema.mysql.prisma && diff prisma/schema.prisma prisma/schema.mysql.prisma | grep -q '^2c2' && echo schemas-in-sync",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:generate:mysql": "prisma generate --schema=prisma/schema.mysql.prisma",
    "migrate:mysql": "prisma migrate dev --schema=prisma/schema.mysql.prisma",
    "migrate:deploy": "prisma migrate deploy --schema=prisma/schema.mysql.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.0.0",
    "resend": "^4.0.0",
    "validation": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "prisma": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
